{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "chore",
        "revert"
      ]
    ],
    "scope-enum": [
      1,
      "always",
      [
        "backend",
        "frontend",
        "redis",
        "manifests",
        "ci",
        "docs",
        "scripts",
        "deps"
      ]
    ],
    "subject-case": [2, "never", ["start-case", "pascal-case", "upper-case"]],
    "subject-empty": [2, "never"],
    "subject-full-stop": [2, "never", "."],
    "header-max-length": [2, "always", 100],
    "body-max-line-length": [1, "always", 150]
  },
  "prompt": {
    "questions": {
      "type": {
        "description": "Tipo da mudança (obrigatório)"
      },
      "scope": {
        "description": "Escopo da mudança: backend, frontend, redis, manifests, ci, docs, scripts, deps"
      },
      "subject": {
        "description": "Descrição curta (imperativo, minúsculas, sem ponto final)"
      },
      "body": {
        "description": "Descrição detalhada (opcional)"
      },
      "breaking": {
        "description": "Breaking changes? Descreva o impacto (opcional)"
      },
      "issues": {
        "description": "Issues relacionadas, ex: #123 (opcional)"
      }
    }
  }
}
